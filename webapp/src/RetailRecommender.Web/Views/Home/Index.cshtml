@model IEnumerable<RetailRecommender.Web.Models.Product>
@{ ViewData["Title"] = "Trang chủ"; }
<section class="hero-panel rounded-4 p-4 p-md-5 mb-4">
    <div class="row align-items-center g-4"><div class="col-lg-8"><p class="text-primary fw-semibold mb-2">MUA SẮM THÔNG MINH HƠN</p><h1 class="display-6 fw-bold mb-3">Khám phá sản phẩm thường được mua cùng nhau</h1><p class="lead text-secondary mb-0">Tận dụng dữ liệu giao dịch thực tế để đưa ra gợi ý mua kèm phù hợp ngay khi bạn xem sản phẩm.</p></div><div class="col-lg-4 text-lg-end"><a class="btn btn-primary btn-lg px-4" asp-controller="Products" asp-action="Index">Xem tất cả sản phẩm</a></div></div>
</section>
<section class="row row-cols-1 row-cols-sm-3 g-3 mb-5" aria-label="Quy mô hệ thống">
    <div class="col"><div class="stat-card"><span class="stat-value">@ViewBag.ProductCount.ToString("N0")</span><span>Sản phẩm trong catalog</span></div></div>
    <div class="col"><div class="stat-card"><span class="stat-value">@ViewBag.RuleCount.ToString("N0")</span><span>Luật kết hợp đã khai phá</span></div></div>
    <div class="col"><div class="stat-card"><span class="stat-value">@ViewBag.RecommendedProductCount.ToString("N0")</span><span>Sản phẩm có gợi ý</span></div></div>
</section>
<section><div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3"><div><h2 class="h3 mb-1">Sản phẩm nổi bật</h2><p class="text-secondary mb-0">Có nhiều gợi ý mua kèm nhất trong hệ thống.</p></div><a asp-controller="Products" asp-action="Index" class="link-primary fw-semibold">Xem toàn bộ →</a></div>
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3">
@foreach (var product in Model) { <div class="col"><article class="card product-card h-100">@if (!string.IsNullOrWhiteSpace(product.ImageUrl)) { <img src="@product.ImageUrl" alt="@product.Description" class="product-thumb" loading="lazy" /> } else { <div class="product-placeholder">⌁</div> }<div class="card-body d-flex flex-column"><span class="badge bg-success align-self-start mb-2">Có gợi ý</span><h3 class="h6 card-title line-clamp-2">@product.Description</h3><p class="text-muted small mb-3">SKU: @product.Sku</p><div class="mt-auto d-flex justify-content-between align-items-center gap-2"><strong class="text-primary">@product.UnitPrice.ToString("N2")</strong><a class="btn btn-outline-primary btn-sm" asp-controller="Products" asp-action="Details" asp-route-sku="@product.Sku">Xem chi tiết</a></div></div></article></div> }
</div></section>
