@model IEnumerable<RetailRecommender.Web.Controllers.CartLine>
@using RetailRecommender.Web.Models
@{ ViewData["Title"] = "Giỏ hàng"; var suggestions = (IReadOnlyList<Recommendation>)ViewBag.Recommendations; var subtotal = Model.Sum(x => x.Product.UnitPrice * x.Quantity); }
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li><li class="breadcrumb-item active" aria-current="page">Giỏ hàng</li></ol></nav>
<div class="d-flex justify-content-between align-items-end mb-4"><div><h1 class="h2 mb-1">Giỏ hàng</h1><p class="text-secondary mb-0">Kiểm tra sản phẩm trước khi đặt hàng.</p></div></div>
@if (!Model.Any()) { <section class="empty-state text-center p-5 rounded-4"><div class="empty-icon">🛒</div><h2 class="h4">Giỏ hàng của bạn đang trống</h2><p class="text-secondary">Hãy khám phá catalog để tìm sản phẩm phù hợp.</p><a class="btn btn-primary" asp-controller="Products" asp-action="Index">Tiếp tục mua sắm</a></section> }
else { <div class="row g-4"><div class="col-lg-8"><div class="card border-0 shadow-sm"><div class="table-responsive"><table class="table align-middle mb-0"><thead class="table-light"><tr><th>Sản phẩm</th><th class="text-center">Số lượng</th><th class="text-end">Thành tiền</th><th><span class="visually-hidden">Xóa</span></th></tr></thead><tbody>@foreach (var line in Model) { <tr><td><div class="d-flex align-items-center gap-3">@if (!string.IsNullOrWhiteSpace(line.Product.ImageUrl)) { <img src="@line.Product.ImageUrl" alt="@line.Product.Description" style="width:48px;height:48px;object-fit:cover;border-radius:.375rem;flex:none" loading="lazy" /> } else { <div class="product-placeholder" style="width:48px;height:48px;border-radius:.375rem;flex:none;font-size:1.1rem">⌁</div> }<div><div class="fw-semibold">@line.Product.Description</div><small class="text-muted">SKU: @line.Product.Sku · @line.Product.UnitPrice.ToString("N2")</small></div></div></td><td class="text-center">@line.Quantity</td><td class="text-end fw-semibold">@((line.Product.UnitPrice * line.Quantity).ToString("N2"))</td><td class="text-end"><form asp-action="Remove" method="post"><input type="hidden" name="sku" value="@line.Product.Sku"/><button class="btn btn-outline-danger btn-sm" type="submit" aria-label="Xóa @line.Product.Description">× <span class="d-none d-sm-inline">Xóa</span></button></form></td></tr> }</tbody></table></div></div></div><div class="col-lg-4"><aside class="card border-0 shadow-sm summary-card"><div class="card-body p-4"><h2 class="h5">Tóm tắt đơn hàng</h2><div class="d-flex justify-content-between text-secondary my-3"><span>Tạm tính</span><span>@subtotal.ToString("N2")</span></div><hr /><div class="d-flex justify-content-between h5 mb-4"><span>Tổng cộng</span><strong class="text-primary">@subtotal.ToString("N2")</strong></div><form asp-controller="Orders" asp-action="Checkout" method="post"><button class="btn btn-success w-100 py-2" type="submit">Đặt hàng</button></form></div></aside></div></div> }
@if (Model.Any()) { <section class="mt-5"><div class="mb-3"><h2 class="h3 mb-1">Có thể bạn cũng thích</h2><p class="text-secondary mb-0">Gợi ý bổ sung dựa trên các sản phẩm trong giỏ.</p></div>@if (!suggestions.Any()) { <div class="empty-state p-4 rounded-4"><p class="mb-0 text-secondary">Chưa có gợi ý phù hợp cho giỏ hàng hiện tại.</p></div> } else { <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-3">@foreach (var item in suggestions) { <div class="col"><article class="card product-card h-100">@if (!string.IsNullOrWhiteSpace(item.Product.ImageUrl)) { <img src="@item.Product.ImageUrl" alt="@item.Product.Description" class="product-thumb" loading="lazy" /> } else { <div class="product-placeholder">⌁</div> }<div class="card-body"><h3 class="h6 line-clamp-2">@item.Product.Description</h3><div class="d-flex gap-1 mb-3"><span class="badge bg-primary">Tin cậy @item.Confidence.ToString("P0")</span><span class="badge bg-light border text-dark">Lift @item.Lift.ToString("N2")</span></div><a class="btn btn-outline-primary btn-sm" asp-controller="Products" asp-action="Details" asp-route-sku="@item.Product.Sku">Xem sản phẩm</a></div></article></div> }</div> }</section> }
