<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Retail Recommender</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RetailRecommender.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Retail Recommender</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Mở điều hướng"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-lg-auto gap-lg-1">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">Sản phẩm</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Cart" asp-action="Index">Giỏ hàng <vc:cart-summary /></a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Rules">Luật kết hợp</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container page-container">
        @if (TempData["Message"] is string message)
        {
            <div class="alert alert-success alert-dismissible fade show mt-4 mb-0" role="alert">
                @message<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }
        <main role="main" class="py-4">@RenderBody()</main>
    </div>
    <footer class="border-top bg-white py-3 mt-auto">
        <div class="container small text-muted d-flex flex-column flex-sm-row justify-content-between gap-1"><span>© 2026 Retail Recommender</span><span>Gợi ý mua kèm dựa trên luật kết hợp</span></div>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
