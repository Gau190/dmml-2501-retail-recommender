@model RetailRecommender.Web.Models.Product
@using RetailRecommender.Web.Models
@{ ViewData["Title"] = Model.Description; var suggestions = (IReadOnlyList<Recommendation>)ViewBag.Recommendations; }
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li><li class="breadcrumb-item"><a asp-action="Index">Sản phẩm</a></li><li class="breadcrumb-item active text-truncate" aria-current="page">@Model.Description</li></ol></nav>
<section class="card border-0 shadow-sm mb-5"><div class="row g-0"><div class="col-md-4">@if (!string.IsNullOrWhiteSpace(Model.ImageUrl)) { <img src="@Model.ImageUrl" alt="@Model.Description" class="detail-thumb" loading="lazy" /> } else { <div class="product-placeholder detail-placeholder">⌁</div> }</div><div class="col-md-8"><div class="card-body p-4 p-lg-5"><span class="badge bg-light border text-dark mb-3">SKU: @Model.Sku</span><h1 class="h2 fw-bold">@Model.Description</h1><p class="display-6 text-primary fw-bold my-4">@Model.UnitPrice.ToString("N2")</p><form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="sku" value="@Model.Sku" /><button class="btn btn-primary btn-lg px-4" type="submit">Thêm vào giỏ</button></form></div></div></div></section>
<section><div class="mb-3"><h2 class="h3 mb-1">Khách hàng cũng mua</h2><p class="text-secondary mb-0">Những sản phẩm khách hàng khác thường mua cùng món này.</p></div>
@if (!suggestions.Any()) { <div class="empty-state p-4 rounded-4"><div class="empty-icon">◎</div><h3 class="h5">Chưa có gợi ý mua kèm cho sản phẩm này</h3><p class="text-secondary mb-0">Bạn vẫn có thể khám phá thêm sản phẩm khác.</p></div> }
else { <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-4 g-3">@foreach (var item in suggestions) { <div class="col"><article class="card product-card h-100">@if (!string.IsNullOrWhiteSpace(item.Product.ImageUrl)) { <img src="@item.Product.ImageUrl" alt="@item.Product.Description" class="product-thumb" loading="lazy" /> } else { <div class="product-placeholder">⌁</div> }<div class="card-body"><h3 class="h6 line-clamp-2">@item.Product.Description</h3><p class="small text-muted">SKU: @item.Product.Sku</p><div class="d-flex flex-wrap gap-1 mb-3"><span class="badge bg-primary">Tin cậy @item.Confidence.ToString("P0")</span><span class="badge bg-light border text-dark">Lift @item.Lift.ToString("N2")</span></div><a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-sku="@item.Product.Sku">Xem chi tiết</a></div></article></div> }</div> }
</section>
