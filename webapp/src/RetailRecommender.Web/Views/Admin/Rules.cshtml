@model IEnumerable<RetailRecommender.Web.Models.AssociationRule>
@{ ViewData["Title"] = "Luật kết hợp"; }
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li><li class="breadcrumb-item active" aria-current="page">Luật kết hợp</li></ol></nav>
<div class="mb-4"><h1 class="h2 mb-1">Luật kết hợp đã khai phá</h1><p class="text-secondary mb-0">Các cặp sản phẩm thường xuất hiện cùng nhau trong dữ liệu giao dịch.</p></div>
<div class="card border-0 shadow-sm"><div class="card-body p-0"><div class="p-3 border-bottom"><input id="ruleSearch" class="form-control" placeholder="Lọc theo SKU…" aria-label="Lọc luật theo SKU" /></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Nếu mua (SKU)</th><th>Gợi ý (SKU)</th><th>Support</th><th>Confidence</th><th>Lift</th></tr></thead><tbody id="rulesBody">@foreach (var rule in Model) { var confidenceClass = rule.Confidence >= 0.5 ? "bg-success" : rule.Confidence >= 0.25 ? "bg-warning text-dark" : "bg-secondary"; <tr><td><a asp-controller="Products" asp-action="Details" asp-route-sku="@rule.AntecedentSku" class="fw-semibold text-decoration-none">@rule.AntecedentSku</a></td><td><a asp-controller="Products" asp-action="Details" asp-route-sku="@rule.ConsequentSku" class="text-decoration-none">@rule.ConsequentSku</a></td><td>@rule.Support.ToString("P2")</td><td><span class="badge @confidenceClass">@rule.Confidence.ToString("P0")</span></td><td>@rule.Lift.ToString("N2")</td></tr> }</tbody></table></div></div></div>
@section Scripts { <script>document.getElementById('ruleSearch').addEventListener('input', function () { const term = this.value.toLowerCase(); document.querySelectorAll('#rulesBody tr').forEach(row => row.hidden = !row.textContent.toLowerCase().includes(term)); });</script> }
